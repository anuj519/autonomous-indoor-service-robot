            <box><size>0.2 12 2.5</size></box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Internal walls with central lobby -->

    <model name="north_left">
      <static>true</static>
      <pose>-4 2.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
