<?xml version="1.0"?>
<sdf version="1.6">
  <world name="office_fasttrack">

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <scene>
      <shadows>false</shadows>
    </scene>

    <!-- Outer walls -->

    <model name="north_wall">
      <static>true</static>
      <pose>0 6 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>16 0.2 2.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>16 0.2 2.5</size></box>
          </geometry>
        </visual>
      </link>
    </model>

    <model name="south_wall">
      <static>true</static>
      <pose>0 -6 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>16 0.2 2.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>16 0.2 2.5</size></box>
          </geometry>
        </visual>
      </link>
    </model>

    <model name="west_wall">
      <static>true</static>
      <pose>-8 0 1.25 0 0 0</pose>
      <link name="link">
